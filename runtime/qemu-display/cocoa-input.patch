+/* Queue coordinates before buttons: devices may hit-test on button delivery. */
+- (void) queueMousePosition:(NSEvent *)event
+{
+    if (isAbsoluteEnabled) {
+        /* View bounds are guest-sized; conversion handles scaling and offsets. */
+        NSPoint p = [self convertPoint:[event locationInWindow] fromView:nil];
+        qemu_input_queue_abs(dcl.con, INPUT_AXIS_X, p.x, 0, screen.width);
+        qemu_input_queue_abs(dcl.con, INPUT_AXIS_Y, screen.height - p.y, 0, screen.height);
+    } else {
+        qemu_input_queue_rel(dcl.con, INPUT_AXIS_X, [event deltaX]);
+        qemu_input_queue_rel(dcl.con, INPUT_AXIS_Y, [event deltaY]);
+    }
+}
